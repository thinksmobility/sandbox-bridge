{
  "name": "sandbox-expo-kit",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build:web": "expo export -p web",
    "manifest:build": "node scripts/build-manifest.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:single-react": "node scripts/check-single-react.mjs",
    "release": "npm run build:web && npm run check:single-react && npm run manifest:build && cp sandbox.manifest.json dist/"
  },
  "dependencies": {
    "@tmob/sandbox-bridge": "file:../..",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "leaflet": "^1.9.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.18",
    "nativewind": "^4.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
